# Colour Dice Arena — frontend environment
# Copy to `.env.local`. These NEXT_PUBLIC_* values are inlined into the client
# bundle at BUILD time — changing them in production requires a redeploy.

# Base URL of the Express backend (Render in prod). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Socket.io origin. In production this is the SAME Render origin (https://...).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
