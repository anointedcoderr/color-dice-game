# ─────────────────────────────────────────────────────────────────────────────
# Colour Dice Arena — backend environment
# Copy to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase Postgres (Prisma) ──────────────────────────────────────────────
# DATABASE_URL = POOLED connection (Supavisor / PgBouncer), used at RUNTIME.
#   Port 6543 (transaction mode). `pgbouncer=true` tells Prisma to disable
#   prepared statements (the transaction pooler does not support them).
DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL = DIRECT connection (port 5432), used ONLY for migrations.
#   Prisma Migrate needs a real session (advisory locks / DDL), which the
#   transaction pooler forbids.
DIRECT_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000

# Comma-separated list of allowed browser origins (CORS + Socket.io CORS).
# Include your local dev origin and your deployed Vercel domain.
# Any *.vercel.app origin is also allowed automatically (for preview deploys).
CLIENT_ORIGIN="http://localhost:3000,https://your-app.vercel.app"

# ── Seeded admin account (created by `npm run seed`) ─────────────────────────
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@colourdice.local"
ADMIN_PASSWORD="ChangeMe123!"

# ── Optional: auto-resolve a round if a player never taps (ms). 0 = disabled ──
ROUND_TAP_TIMEOUT_MS=0

# ── Optional (post-MVP horizontal scaling) ──────────────────────────────────
# REDIS_URL="rediss://default:<token>@<name>.upstash.io:6379"
