{
  "name": "colour-dice-arena",
  "private": true,
  "version": "1.0.0",
  "description": "Colour Dice Arena — a provably-fair multiplayer colour dice game (Next.js + Express + Socket.io + Prisma).",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "concurrently -n web,server -c blue,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspace=apps/server && npm run build --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:server": "npm run build --workspace=apps/server",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/server",
    "prisma:generate": "npm run prisma:generate --workspace=apps/server",
    "seed": "npm run seed --workspace=apps/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
